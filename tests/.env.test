# Test environment — dummy values satisfy envalid strict validation.
# No real DB or SMTP is used; all deps are stubbed in tests.
NODE_ENV=test
PORT=5001

MONGO_URI=mongodb://127.0.0.1:27017/test_db

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@example.com
SMTP_PASS=test_password
EMAIL_FROM="Test App <no-reply@test.com>"

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SIGNUP_RATE_LIMIT_WINDOW_MS=3600000
SIGNUP_RATE_LIMIT_MAX=10

UNVERIFIED_ACCOUNT_TTL_HOURS=24
CLEANUP_CRON_SCHEDULE=0 * * * *

LOG_LEVEL=error
