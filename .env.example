# ─────────────────────────────────────────────
#  Server
# ─────────────────────────────────────────────
NODE_ENV=development            # development | production | test
PORT=5000

# ─────────────────────────────────────────────
#  MongoDB
# ─────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/enterprise_signup

# ─────────────────────────────────────────────
#  Email (SMTP via Nodemailer)
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false               # true for port 465 (TLS), false for STARTTLS
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password     # Use an App Password, NOT your account password
EMAIL_FROM="Enterprise App <no-reply@example.com>"

# ─────────────────────────────────────────────
#  OTP Config
# ─────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10           # OTP validity window
OTP_MAX_ATTEMPTS=5              # Max failed verify attempts before lockout
OTP_RESEND_COOLDOWN_SECONDS=60  # Min seconds between resend requests

# ─────────────────────────────────────────────
#  Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000     # 15 minutes in milliseconds
RATE_LIMIT_MAX=100              # Max requests per window per IP

SIGNUP_RATE_LIMIT_WINDOW_MS=3600000   # 1 hour
SIGNUP_RATE_LIMIT_MAX=10              # Max signup attempts per hour per IP

# ─────────────────────────────────────────────
#  Cleanup Job
# ─────────────────────────────────────────────
UNVERIFIED_ACCOUNT_TTL_HOURS=24   # Delete unverified accounts older than N hours
CLEANUP_CRON_SCHEDULE="0 * * * *" # Run every hour

# ─────────────────────────────────────────────
#  Logging
# ─────────────────────────────────────────────
LOG_LEVEL=info                  # error | warn | info | http | debug
