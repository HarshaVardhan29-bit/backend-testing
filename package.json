{
  "name": "enterprise-signup-api",
  "version": "1.0.0",
  "description": "Enterprise-level signup authentication APIs — Node.js + Express + MongoDB",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "mocha --require tests/setup.js --recursive tests --exit --timeout 5000",
    "test:watch": "mocha --require tests/setup.js --recursive tests --exit --timeout 5000 --watch",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "signup",
    "api",
    "enterprise"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "envalid": "^8.0.0",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "uuid": "^11.0.0",
    "winston": "^3.13.0",
    "xss": "^1.0.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "eslint": "^9.7.0",
    "mocha": "^11.8.0",
    "nodemon": "^3.1.4",
    "proxyquire": "^2.1.3",
    "sinon": "^22.1.0"
  }
}
